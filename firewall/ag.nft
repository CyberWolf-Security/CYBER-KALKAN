table inet kalkan_ag {
  set yonetim {
    type inet_service
    elements = { 22, 2083, 2087, 8083, 8890, 8899 }
  }
  chain girdi {
    type filter hook input priority -200; policy accept;
    ct state established,related return
    iif "lo" return
    tcp dport @yonetim return
    tcp dport { 80, 443 } return
    counter comment "wan-yeni-giris"
  }
  chain cikti {
    type filter hook output priority -200; policy accept;
    ct state established,related return
    counter comment "lan-cikis"
  }
  chain yonlendir {
    type filter hook forward priority -200; policy accept;
    ct state established,related return
  }
}
