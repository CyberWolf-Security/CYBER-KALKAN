[Unit]
Description=CYBER KALKAN Inline IPS (nfqueue + Suricata)
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /opt/siber-kalkan/MOTOR/kalkan_ips_v10.py baslat --onay
ExecStop=/usr/bin/python3 /opt/siber-kalkan/MOTOR/kalkan_ips_v10.py durdur
StandardOutput=append:/opt/siber-kalkan/LOG/ips.log
StandardError=append:/opt/siber-kalkan/LOG/ips.log

[Install]
WantedBy=multi-user.target
