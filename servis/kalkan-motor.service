[Unit]
Description=CYBER KALKAN Gercek Zamanli Motor (dongu modu)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/siber-kalkan/MOTOR/kalkan_motor.py --dongu
Restart=always
RestartSec=5
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=5

[Install]
WantedBy=multi-user.target
