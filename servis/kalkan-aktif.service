[Unit]
Description=CYBER KALKAN Aktif Savunma (honeypot)
After=network.target
[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/siber-kalkan/MOTOR/kalkan_aktif_savunma.py
Restart=always
RestartSec=10
StandardOutput=append:/opt/siber-kalkan/LOG/aktif.log
StandardError=append:/opt/siber-kalkan/LOG/aktif.log
[Install]
WantedBy=multi-user.target
